# ==============================================================================
# CivicResolve Environment Configuration
# Copy this file to .env.local and fill in your Google Cloud / Firebase keys.
# Never commit .env.local or any static service account JSON key files.
# ==============================================================================

# --- Google Gemini AI (@google/genai) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Google Cloud & Firebase Admin (ADC) ---
# Firebase Admin SDK uses Application Default Credentials (ADC) automatically.
# Run `gcloud auth application-default login` locally; Cloud Run uses attached IAM service account.
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# --- Firebase Client SDK (Browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_gcp_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# --- Google Maps Platform ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_js_api_key

# --- Role RBAC & Judge Demo Mode ---
# Comma-separated list of Firebase Auth emails granted Municipal Authority access (/admin & PATCH /api/issues/[id])
ADMIN_EMAILS=admin@civicresolve.gov
# Comma-separated list of Firebase Auth emails granted Field Worker access (/worker & POST /api/issues/[id]/worker-action)
WORKER_EMAILS=worker@civicresolve.gov
# Set to "false" to disable the Demo login shortcuts in production
DEMO_ADMIN_ENABLED=true
# Secret used to sign HttpOnly Demo Admin session cookies (generate a 32+ char random string in production)
DEMO_ADMIN_SESSION_SECRET=change-me-to-a-random-32-char-secret
