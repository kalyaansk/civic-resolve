rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.authority == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'authority']
        )
      );
    }

    function isWorker() {
      return isSignedIn() && !isAdmin() && (
        request.auth.token.worker == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'worker'
        )
      );
    }

    function isValidWorkerUpdate() {
      return isWorker()
        && resource.data.status in ['Reported', 'In Progress']
        && request.resource.data.status in ['In Progress', 'Pending Verification']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completionReport', 'statusHistory', 'updatedAt'
        ]);
    }

    function isValidCitizenUpvoteUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'upvotes', 'upvotedBy', 'updatedAt'
        ])
        && request.resource.data.upvotes is int
        && request.resource.data.upvotedBy is list
        && (
          (
            !(request.auth.uid in resource.data.upvotedBy)
            && request.auth.uid in request.resource.data.upvotedBy
            && request.resource.data.upvotes == resource.data.upvotes + 1
          ) || (
            request.auth.uid in resource.data.upvotedBy
            && !(request.auth.uid in request.resource.data.upvotedBy)
            && request.resource.data.upvotes == resource.data.upvotes - 1
          )
        );
    }

    match /issues/{issueId} {
      // Public transparency dashboard allows reading civic issues (no email fields stored)
      allow read: if true;

      // Authenticated Citizens (never Field Workers) create issues stamped with their own UID
      allow create: if isSignedIn()
        && !isWorker()
        && request.resource.data.keys().hasAll([
          'title', 'description', 'category', 'status', 'priority',
          'urgencyScore', 'department', 'state', 'city', 'location',
          'reporterUid', 'upvotes', 'upvotedBy', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 6
        && request.resource.data.title.size() <= 140
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 15
        && request.resource.data.description.size() <= 1000
        && request.resource.data.state is string
        && request.resource.data.state.size() >= 2
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.status == 'Reported'
        && request.resource.data.urgencyScore is int
        && request.resource.data.urgencyScore >= 1
        && request.resource.data.urgencyScore <= 100;

      // Authorities manage full lifecycle; Field Workers submit completion proof; Citizens toggle upvotes
      allow update: if isAdmin() || isValidWorkerUpdate() || isValidCitizenUpvoteUpdate();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'citizen';
      allow update, delete: if isAdmin();
    }
  }
}
